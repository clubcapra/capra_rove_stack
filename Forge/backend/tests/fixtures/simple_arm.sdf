<?xml version="1.0"?>
<sdf version="1.7">
  <model name="simple_arm_sdf">
    <link name="base_link">
      <inertial>
        <pose>0 0 0.05 0 0 0</pose>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.01</ixx><iyy>0.01</iyy><izz>0.005</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="vis">
        <geometry>
          <box><size>0.2 0.2 0.1</size></box>
        </geometry>
      </visual>
      <collision name="col">
        <geometry>
          <box><size>0.2 0.2 0.1</size></box>
        </geometry>
      </collision>
    </link>

    <link name="upper_arm">
      <pose>0 0 0.1 0 0 0</pose>
      <inertial>
        <pose>0 0 0.15 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.02</ixx><iyy>0.02</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="vis">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.04</radius><length>0.3</length></cylinder>
        </geometry>
      </visual>
    </link>

    <joint name="shoulder_pan" type="revolute">
      <parent>base_link</parent>
      <child>upper_arm</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14</lower><upper>3.14</upper>
          <effort>100</effort><velocity>1.5</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping><friction>0.1</friction>
        </dynamics>
      </axis>
    </joint>

    <link name="forearm">
      <pose>0 0 0.4 0 0 0</pose>
      <inertial>
        <pose>0 0 0.12 0 0 0</pose>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx><iyy>0.01</iyy><izz>0.0005</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="vis">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.03</radius><length>0.24</length></cylinder>
        </geometry>
      </visual>
    </link>

    <joint name="elbow" type="revolute">
      <parent>upper_arm</parent>
      <child>forearm</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-2.0</lower><upper>2.0</upper>
          <effort>50</effort><velocity>2.0</velocity>
        </limit>
      </axis>
    </joint>
  </model>
</sdf>
