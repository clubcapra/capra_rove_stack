<?xml version="1.0"?>
<mujoco model="simple_arm_mjcf">
  <asset>
    <material name="steel" rgba="0.7 0.7 0.72 1.0"/>
  </asset>
  <worldbody>
    <body name="base_link" pos="0 0 0">
      <inertial pos="0 0 0.05" mass="5.0" diaginertia="0.01 0.01 0.005"/>
      <geom type="box" size="0.1 0.1 0.05" material="steel"/>

      <body name="upper_arm" pos="0 0 0.1">
        <joint name="shoulder_pan" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
        <inertial pos="0 0 0.15" mass="2.0" diaginertia="0.02 0.02 0.001"/>
        <geom type="cylinder" pos="0 0 0.15" size="0.04 0.15" material="steel"/>

        <body name="forearm" pos="0 0 0.3">
          <joint name="elbow" type="hinge" axis="0 1 0" range="-2.0 2.0"/>
          <inertial pos="0 0 0.12" mass="1.0" diaginertia="0.01 0.01 0.0005"/>
          <geom type="cylinder" pos="0 0 0.12" size="0.03 0.12"/>

          <body name="end_effector" pos="0 0 0.24">
            <inertial mass="0.1" diaginertia="0.0001 0.0001 0.0001"/>
            <geom type="sphere" size="0.02"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
